{
  "version": 3,
  "name": "Wikipedia Search",
  "description": "Opens Wikipedia, searches for \"automation\", opens the article and follows a link from it. A short browser-automation demo that needs internet access.",
  "tags": [
    "Example",
    "Browser",
    "Web"
  ],
  "browserSession": {
    "captureFinalScreenshot": true
  },
  "nodes": [
    {
      "id": "n1",
      "type": "start",
      "ref": "start_1",
      "params": {}
    },
    {
      "id": "n2",
      "type": "browser_open_url",
      "ref": "browser_open_url_2",
      "params": {
        "newTab": false,
        "url": "https://www.wikipedia.org/"
      }
    },
    {
      "id": "n3",
      "type": "browser_open_url",
      "ref": "browser_open_url_3",
      "params": {
        "newTab": false,
        "url": "https://www.wikipedia.org/"
      }
    },
    {
      "id": "n4",
      "type": "browser_click",
      "ref": "browser_click_4",
      "params": {
        "selector": "aria/English 7,189,000+ articles\ndiv.lang1 strong\nxpath=//*[@id=\"js-link-box-en\"]/strong\npierce/div.lang1 strong",
        "timeoutSec": 30
      }
    },
    {
      "id": "n5",
      "type": "browser_click",
      "ref": "browser_click_5",
      "params": {
        "selector": "aria/Search Wikipedia\n#searchInput\nxpath=//*[@id=\"searchInput\"]\npierce/#searchInput",
        "timeoutSec": 30
      }
    },
    {
      "id": "n6",
      "type": "browser_type",
      "ref": "browser_type_6",
      "params": {
        "clearFirst": true,
        "selector": "aria/Search Wikipedia\n#searchform > div input\nxpath=//*[@id=\"searchform\"]/div/div/div[1]/input\npierce/#searchform > div input",
        "text": "automation"
      }
    },
    {
      "id": "n7",
      "type": "browser_click",
      "ref": "browser_click_7",
      "params": {
        "selector": "#v-1-23 span.cdx-menu-item__text\nxpath=//*[@id=\"v-1-23\"]/a/span[2]\npierce/#v-1-23 span.cdx-menu-item__text\ntext=AutomationUse",
        "timeoutSec": 30
      }
    },
    {
      "id": "n8",
      "type": "browser_click",
      "ref": "browser_click_8",
      "params": {
        "selector": "aria/paradox\n#mwAco\nxpath=//*[@id=\"mwAco\"]\npierce/#mwAco",
        "timeoutSec": 30
      }
    },
    {
      "id": "n9",
      "type": "end",
      "ref": "end_9",
      "params": {}
    }
  ],
  "edges": [
    {
      "sourceId": "n1",
      "targetId": "n2"
    },
