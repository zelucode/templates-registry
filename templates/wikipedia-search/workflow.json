{
  "version": 3,
  "name": "Wikipedia Search",
  "description": "Opens Wikipedia, searches for \"automation\", opens the article and reads its title. A short browser-automation demo. Needs internet access.",
  "tags": [
    "Example",
    "Browser",
    "Web"
  ],
  "browserSession": {
    "captureFinalScreenshot": true
  },
  "nodes": [
    {
      "id": "n1",
      "type": "start",
      "ref": "start_1",
      "params": {}
    },
    {
      "id": "n2",
      "type": "browser_open_url",
      "ref": "browser_open_url_2",
      "params": {
        "newTab": false,
        "url": "https://www.wikipedia.org/"
      }
    },
    {
      "id": "n3",
      "type": "browser_click",
      "ref": "browser_click_3",
      "params": {
        "selector": "#js-link-box-en",
        "timeoutSec": 30
      }
    },
    {
      "id": "n4",
      "type": "browser_click",
      "ref": "browser_click_4",
      "params": {
        "selector": "#searchInput",
        "timeoutSec": 30
      }
    },
    {
      "id": "n5",
      "type": "browser_type",
      "ref": "browser_type_5",
      "params": {
        "clearFirst": true,
        "selector": "#searchInput",
        "text": "automation"
      }
    },
    {
      "id": "n6",
      "type": "browser_key_press",
      "ref": "browser_key_press_6",
      "params": {
        "key": "Enter"
      }
    },
    {
      "id": "n7",
      "type": "browser_extract_text",
      "ref": "browser_extract_text_7",
      "params": {
        "selector": "#firstHeading"
      }
    },
    {
      "id": "n8",
      "type": "end",
      "ref": "end_8",
      "params": {}
    }
  ],
  "edges": [
    {
      "sourceId": "n1",
      "targetId": "n2"
    },
    {
      "sourceId": "n2",
      "targetId": "n3"
    },
    {
      "sourceId": "n3",
      "targetId": "n4"
    },
    {
      "sourceId": "n4",
      "targetId": "n5"
    },
    {
      "sourceId": "n5",
      "targetId": "n6"
    },
    {
      "sourceId": "n6",
      "targetId": "n7"
    },
    {
      "sourceId": "n7",
      "targetId": "n8"
    }
  ]
}
